#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# pre-commit — block the two mistakes that are unrecoverable in a PUBLIC repo.
#
# Version-controlled on purpose: `git config core.hooksPath .githooks` (bin/install does
# this) so the guard travels with the repo instead of living in one machine's .git/hooks.

set -uo pipefail
fail=0
say() { printf 'pre-commit: %s\n' "$1" >&2; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

# --- 1. never commit key material -------------------------------------------------
# git-crypt's whole guarantee is void the moment the key lands next to the ciphertext.
while IFS= read -r f; do
  case "$f" in
    *.key|*.pem|*.p12|.git-crypt/keys/*|*id_rsa|*id_ed25519)
      say "REFUSING — key material staged: $f"; fail=1 ;;
  esac
  # A git-crypt key file by content, whatever it is named.
  if [ -f "$f" ] && head -c 9 "$f" 2>/dev/null | grep -qa GITCRYPT && \
     [ "$(git check-attr filter -- "$f" | sed 's|.*: ||')" = "unspecified" ]; then
    say "REFUSING — $f looks like git-crypt key material but is not an encrypted path"
    fail=1
  fi
done <<< "$staged"

# --- 2. every tier-1 file must actually be ciphertext in the index -----------------
# This is the canary check, automated. If .gitattributes ever breaks — a bad pattern, a
# new path nobody routed, a year rolling over — a tier-1 file lands in public history as
# plaintext and cannot be recalled. Read the STAGED BLOB, not the working file.
while IFS= read -r f; do
  filt=$(git check-attr filter -- "$f" | sed 's|.*: filter: ||')
  case "$filt" in
    git-crypt*) ;;
    *) continue ;;
  esac
  if ! git cat-file -p ":$f" 2>/dev/null | head -c 9 | grep -qa GITCRYPT; then
    say "REFUSING — $f routes to '$filt' but staged as PLAINTEXT"
    say "           is the repo locked, or did .gitattributes change?"
    fail=1
  fi
done <<< "$staged"

# --- 3. gitleaks, when available ---------------------------------------------------
# CI cannot do this job: it has no key, so it would only ever scan ciphertext. The scan
# has to run where the plaintext is, which is here.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact >/dev/null 2>&1 || {
    say "gitleaks flagged the staged changes — run: gitleaks protect --staged --verbose"
    fail=1
  }
else
  say "note: gitleaks not installed; secret scan skipped (brew install gitleaks)"
fi

# --- 4. markdownlint, when available — warns, never blocks ---------------------------
# Style is recoverable in a follow-up commit, so it doesn't earn a place alongside the
# checks above. Tier-1 paths are skipped by the config's own ignores. Lints the working
# copy, not the staged blob — close enough for a warning.
if command -v markdownlint-cli2 >/dev/null 2>&1; then
  md=()
  while IFS= read -r f; do
    case "$f" in *.md) md+=("$f") ;; esac
  done <<< "$staged"
  if [ "${#md[@]}" -gt 0 ] && ! markdownlint-cli2 "${md[@]}" >/dev/null 2>&1; then
    say "warning: markdownlint flagged staged files — run: markdownlint-cli2 ${md[*]}"
  fi
else
  say "note: markdownlint-cli2 not installed; lint skipped (brew bundle)"
fi

[ "$fail" -eq 0 ] || { say "commit blocked."; exit 1; }
exit 0
