#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# scripts/build-catalog [upstream-checkout] > references/catalog.md
#
# Regenerate the design-system catalog from VoltAgent/awesome-claude-design's README.
# The catalog is vendored rather than fetched per run so the skill works offline and a
# change upstream shows up as a reviewable diff, not a silent behaviour change.
#
# With no argument it shallow-clones upstream into a temp dir. The pinned SHAs in the
# header are what make a later diff meaningful — do not hand-edit catalog.md.

set -euo pipefail

UPSTREAM=https://github.com/VoltAgent/awesome-claude-design.git
SRC="${1:-}"
if [ -z "$SRC" ]; then
  SRC=$(mktemp -d)
  trap 'rm -r "$SRC"' EXIT
  git clone -q --depth 1 "$UPSTREAM" "$SRC"
fi
SHA=$(git -C "$SRC" rev-parse HEAD)

# The DESIGN.md bodies live in a sibling repo; getdesign.md itself is a JS app with no
# raw endpoint. Pin its SHA too, so a slug that 404s later is traceable to a rename.
RAW_SHA=$(git ls-remote https://github.com/VoltAgent/awesome-design-md.git HEAD | cut -f1)

cat <<HEADER
<!-- GENERATED by scripts/build-catalog — do not edit by hand. -->

# Design system catalog

Vendored from [VoltAgent/awesome-claude-design](https://github.com/VoltAgent/awesome-claude-design)
at \`${SHA:0:7}\`. MIT licensed — see \`UPSTREAM-LICENSE\`. Raw files resolved against
[VoltAgent/awesome-design-md](https://github.com/VoltAgent/awesome-design-md) at \`${RAW_SHA:0:7}\`.

These are **inspiration, not official brand systems**. None is affiliated with or endorsed
by the company it is named after, and brand names, logos and proprietary typefaces belong
to their owners. Use one as a starting point for an original system, not a 1:1 clone.

Fetch a system's \`DESIGN.md\` by its slug:

\`\`\`text
https://raw.githubusercontent.com/VoltAgent/awesome-design-md/main/design-md/<slug>/DESIGN.md
\`\`\`

Preview it in a browser at \`https://getdesign.md/<slug>/design-md\`.
HEADER

# Upstream shape, one entry per line under "### <Category>" inside "## Collection":
#   - [**Linear**](https://getdesign.md/linear.app/design-md) - Project management. Ultra-minimal
awk '
  /^## Collection/          { on = 1; next }
  on && /^## /              { exit }
  on && /^### /             { printf "\n## %s\n\n| System | Slug | Feel |\n| --- | --- | --- |\n", substr($0, 5); next }
  on && /^- \[\*\*/ {
    name = $0; sub(/^- \[\*\*/, "", name); sub(/\*\*\].*/, "", name)
    slug = $0; sub(/.*getdesign\.md\//, "", slug); sub(/\/design-md\).*/, "", slug)
    feel = $0; sub(/^[^)]*\) - /, "", feel); gsub(/\|/, "\\|", feel)
    printf "| %s | `%s` | %s |\n", name, slug, feel
  }
' "$SRC/README.md"
